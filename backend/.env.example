# Copy this file to .env and fill in real values. Never commit .env.

# Database (PostgreSQL)
DB_NAME=recruitment_db
DB_USER=recruitment_user
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Email (SMTP) — defaults in settings.py target Gmail; override
# EMAIL_HOST/EMAIL_PORT/EMAIL_USE_TLS for a different provider.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

# Frontend origin — used for CORS and links in outgoing emails
FRONTEND_URL=http://localhost:5173

# Google OAuth client ID (required — Google-issued ID tokens must have this
# as their `aud` claim). Get one from Google Cloud Console.
GOOGLE_OAUTH_CLIENT_ID=
